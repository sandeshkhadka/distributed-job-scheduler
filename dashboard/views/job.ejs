<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>djs-admin - Job <%= job.id %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
</head>
<body>
  <aside class="sidebar">
    <h1 class="logo">djs</h1>
    <nav>
      <a href="/">Overview</a>
      <a href="/workers">Workers</a>
      <a href="/jobs">Jobs</a>
    </nav>
  </aside>
  <main class="main">
    <h2>Job #<%= job.id %> — <%= job.job_type %></h2>
    <div class="cards">
      <div class="card small"><span class="label">Status</span><span class="badge <%= job.status %>"><%= job.status %></span></div>
      <div class="card small"><span class="label">Worker</span><span class="num"><%= job.worker_name || '-' %></span></div>
      <div class="card small"><span class="label">Duration</span><span class="num"><%= job.duration_ms ? (job.duration_ms / 1000).toFixed(1) + 's' : '-' %></span></div>
      <div class="card small"><span class="label">Result</span><span class="num"><%= job.success ? '✓' : job.success === null ? '-' : '✗' %></span></div>
    </div>
    <% if (job.message) { %><div class="msg"><%= job.message %></div><% } %>

    <% if (ebpf.length > 0) { %>
    <h3>eBPF Metrics (<%= ebpf.length %> snapshots)</h3>
    <div class="chart-row">
      <div class="chart-box"><canvas id="cpuChart"></canvas></div>
      <div class="chart-box"><canvas id="memChart"></canvas></div>
    </div>
    <div class="chart-row">
      <div class="chart-box"><canvas id="ioChart"></canvas></div>
      <div class="chart-box"><canvas id="netChart"></canvas></div>
    </div>
    <% } else { %>
    <p class="muted">No eBPF metrics available for this job.</p>
    <% } %>
  </main>

  <% if (ebpf.length > 0) { %>
  <script>
    const ebpf = <%- JSON.stringify(ebpf) %>;
    const labels = ebpf.map(d => new Date(d.recorded_at * 1000).toLocaleTimeString());

    new Chart(document.getElementById('cpuChart'), {
      type: 'line',
      data: {
        labels,
        datasets: [{ label: 'CPU Usage (us)', data: ebpf.map(d => d.cpu_usage_us), borderColor: '#4f7cff', fill: true, backgroundColor: 'rgba(79,124,255,0.1)' }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { title: { display: true, text: 'CPU (µs)', color: '#8b949e' } } }
      }
    });

    new Chart(document.getElementById('memChart'), {
      type: 'line',
      data: {
        labels,
        datasets: [{ label: 'Memory (bytes)', data: ebpf.map(d => d.mem_current_bytes), borderColor: '#22c55e', fill: true, backgroundColor: 'rgba(34,197,94,0.1)' }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { title: { display: true, text: 'Memory (bytes)', color: '#8b949e' } } }
      }
    });

    new Chart(document.getElementById('ioChart'), {
      type: 'line',
      data: {
        labels,
        datasets: [
          { label: 'IO Read (bytes)', data: ebpf.map(d => d.io_read_bytes), borderColor: '#4f7cff', fill: true, backgroundColor: 'rgba(79,124,255,0.1)' },
          { label: 'IO Write (bytes)', data: ebpf.map(d => d.io_write_bytes), borderColor: '#f59e0b', fill: true, backgroundColor: 'rgba(245,158,11,0.1)' }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: '#8b949e' } } },
        scales: { y: { title: { display: true, text: 'Bytes', color: '#8b949e' } } }
      }
    });

    new Chart(document.getElementById('netChart'), {
      type: 'line',
      data: {
        labels,
        datasets: [
          { label: 'Net TX (bytes)', data: ebpf.map(d => d.net_tx_bytes), borderColor: '#a855f7', fill: true, backgroundColor: 'rgba(168,85,247,0.1)' },
          { label: 'Net RX (bytes)', data: ebpf.map(d => d.net_rx_bytes), borderColor: '#ec4899', fill: true, backgroundColor: 'rgba(236,72,153,0.1)' }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: '#8b949e' } } },
        scales: { y: { title: { display: true, text: 'Bytes', color: '#8b949e' } } }
      }
    });
  </script>
  <% } %>
</body>
</html>
